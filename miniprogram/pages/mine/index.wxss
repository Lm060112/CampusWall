.page {
  min-height: 100vh;
  padding: 50rpx 24rpx calc(44rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #fbfbfb;
}

.top-actions {
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.action-icons {
  display: flex;
  align-items: center;
  gap: 34rpx;
}

.profile-card {
  position: relative;
  overflow: hidden;
  margin-top: 22rpx;
  padding: 28rpx 24rpx 26rpx;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #eff9ed, #e4f7df);
}

.profile-card::after {
  content: "";
  position: absolute;
  right: -84rpx;
  bottom: -96rpx;
  width: 330rpx;
  height: 330rpx;
  border-radius: 165rpx;
  background: rgba(132, 210, 115, 0.2);
}

.profile-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 22rpx;
}

.avatar {
  width: 122rpx;
  height: 122rpx;
  flex: 0 0 122rpx;
  border: 6rpx solid #fff;
  border-radius: 61rpx;
  background: #dcefe0;
}

.profile-main {
  flex: 1;
  min-width: 220rpx;
}

.nickname {
  display: block;
  color: #111;
  font-size: 40rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.slogan {
  display: block;
  margin-top: 10rpx;
  color: #5f6d61;
  font-size: 27rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.campus-pill {
  display: inline-flex;
  max-width: 100%;
  align-self: flex-start;
  align-items: center;
  gap: 6rpx;
  margin-top: 12rpx;
  padding: 5rpx 12rpx;
  color: #148844;
  font-size: 23rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.72);
}

.campus-pill text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-link {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 14rpx 18rpx;
  color: #148844;
  font-size: 25rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.78);
  flex: 0 0 auto;
}

.stat-row {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin-top: 32rpx;
}

.stat-item {
  min-height: 92rpx;
  min-width: 0;
  text-align: center;
  border-right: 1rpx solid rgba(90, 120, 90, 0.18);
}

.stat-item:last-child {
  border-right: none;
}

.stat-value {
  display: block;
  color: #111;
  font-size: 34rpx;
  font-weight: 900;
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  color: #4f5660;
  font-size: 23rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coupon-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #fff7ec, #ffead1);
}

.admin-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 24rpx;
  border: 1rpx solid #d7f1df;
  border-radius: 8rpx;
  background: #f1fbf4;
}

.admin-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
}

.admin-icon {
  width: 66rpx;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 66rpx;
  border-radius: 8rpx;
  background: #18b866;
}

.admin-title {
  display: block;
  color: #0c2b17;
  font-size: 30rpx;
  font-weight: 900;
}

.admin-desc {
  display: block;
  margin-top: 8rpx;
  color: #53705f;
  font-size: 23rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.admin-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex: 0 0 auto;
  padding: 13rpx 18rpx;
  color: #0d7a3c;
  font-size: 25rpx;
  border-radius: 30rpx;
  background: #fff;
}

.coupon-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
}

.coupon-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  background: #ffb13b;
}

.coupon-title {
  display: block;
  color: #111;
  font-size: 30rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coupon-desc {
  display: block;
  margin-top: 8rpx;
  color: #8a6d4c;
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coupon-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 14rpx 18rpx;
  color: #d66a00;
  font-size: 25rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.78);
}

.panel,
.menu-panel {
  margin-top: 18rpx;
  padding: 24rpx;
  border: 1rpx solid #edf0f3;
  border-radius: 8rpx;
  background: #fff;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #777;
  font-size: 25rpx;
}

.panel-head > text {
  color: #111;
  font-size: 32rpx;
  font-weight: 900;
}

.panel-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  min-height: 52rpx;
  padding-left: 22rpx;
}

.order-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20rpx 12rpx;
  margin-top: 28rpx;
}

.order-item,
.publish-item {
  min-height: 118rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  color: #444;
  font-size: 24rpx;
  text-align: center;
}

.order-item > text,
.publish-item > text {
  width: 100%;
  min-height: 60rpx;
  line-height: 30rpx;
  display: -webkit-box;
  overflow: hidden;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.publish-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22rpx 16rpx;
  margin-top: 30rpx;
}

.publish-item {
  justify-content: flex-start;
  gap: 10rpx;
}

.publish-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-panel {
  padding: 0 24rpx;
}

.menu-row {
  min-height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #edf0f3;
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 22rpx;
  color: #111;
  font-size: 29rpx;
  min-width: 0;
}

.menu-left text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

@media (max-width: 390px) {
  .page {
    padding-left: 20rpx;
    padding-right: 20rpx;
  }

  .profile-card,
  .panel,
  .menu-panel,
  .admin-card,
  .coupon-card {
    padding-left: 20rpx;
    padding-right: 20rpx;
  }

  .avatar {
    width: 108rpx;
    height: 108rpx;
    flex-basis: 108rpx;
    border-radius: 54rpx;
  }

  .profile-link {
    padding: 10rpx 12rpx;
    font-size: 23rpx;
  }

  .order-item,
  .publish-item {
    font-size: 22rpx;
  }

  .order-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .publish-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
