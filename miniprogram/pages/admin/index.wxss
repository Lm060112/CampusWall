.page {
  min-height: 100vh;
  padding: 50rpx 24rpx calc(64rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f5f7f6;
}

.hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 22rpx;
  padding: 22rpx;
  border: 1rpx solid #e5ece8;
  border-radius: 8rpx;
  background: #fff;
}

.title {
  display: block;
  color: #111;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.15;
}

.subtitle {
  display: block;
  margin-top: 10rpx;
  color: #596760;
  font-size: 24rpx;
  line-height: 1.4;
}

.refresh {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex: 0 0 auto;
  min-height: 56rpx;
  padding: 0 16rpx;
  color: #158344;
  font-size: 24rpx;
  border-radius: 8rpx;
  background: #edf9f1;
}

.tabs-scroll {
  margin: 0 -24rpx 18rpx;
  white-space: nowrap;
}

.loading-bar {
  margin-bottom: 14rpx;
  padding: 16rpx 20rpx;
  color: #158344;
  font-size: 24rpx;
  border: 1rpx solid #cdeed8;
  border-radius: 8rpx;
  background: #f1fbf4;
}

.tabs {
  display: inline-flex;
  gap: 14rpx;
  padding: 0 24rpx;
}

.tab {
  min-width: 124rpx;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: #59636b;
  font-size: 26rpx;
  border: 1rpx solid #e4eae7;
  border-radius: 8rpx;
  background: #fff;
}

.tab--active {
  color: #fff;
  border-color: #18bf6a;
  background: #18bf6a;
  font-weight: 800;
}

.filter-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 70rpx;
  min-height: 70rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  color: #111;
  font-size: 25rpx;
  border: 1rpx solid #e1e8e4;
  border-radius: 8rpx;
  background: #fff;
}

.filter-btn {
  width: 96rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #158344;
  font-size: 25rpx;
  border: 1rpx solid #cdeed8;
  border-radius: 8rpx;
  background: #f1fbf4;
}

.section,
.form-card,
.list-card,
.empty {
  border: 1rpx solid #e6ece9;
  border-radius: 8rpx;
  background: #fff;
}

.section {
  padding: 22rpx;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 22rpx;
  min-width: 0;
}

.section-title {
  display: block;
  color: #111;
  font-size: 32rpx;
  font-weight: 900;
}

.section-desc {
  display: block;
  margin-top: 8rpx;
  color: #69736f;
  font-size: 23rpx;
  line-height: 1.45;
}

.section-count {
  flex: 0 0 auto;
  margin-top: 4rpx;
  color: #158344;
  font-size: 24rpx;
  max-width: 220rpx;
  text-align: right;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.dashboard-card {
  min-height: 150rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 22rpx;
  box-sizing: border-box;
  border: 1rpx solid #e1ebe5;
  border-radius: 8rpx;
  background: #f7fcf8;
}

.dashboard-value {
  color: #111;
  font-size: 42rpx;
  font-weight: 900;
}

.dashboard-label {
  margin-top: 10rpx;
  color: #5d6a62;
  font-size: 24rpx;
}

.form-card {
  margin-bottom: 24rpx;
  padding: 22rpx;
}

.form-title,
.list-title {
  display: block;
  color: #111;
  font-size: 28rpx;
  font-weight: 900;
}

.form-title {
  margin-bottom: 18rpx;
}

.list-title {
  margin: 26rpx 0 14rpx;
}

.field {
  margin-bottom: 18rpx;
}

.field > text {
  display: block;
  margin-bottom: 10rpx;
  color: #313a34;
  font-size: 24rpx;
  font-weight: 700;
}

.field-tip {
  display: block;
  margin-top: 10rpx;
  color: #158344;
  font-size: 23rpx;
}

.field-with-action {
  display: flex;
  gap: 12rpx;
}

.field-with-action input {
  flex: 1;
  min-width: 0;
}

.inline-btn {
  width: 104rpx;
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #158344;
  font-size: 25rpx;
  border: 1rpx solid #bfe6cc;
  border-radius: 8rpx;
  background: #f1fbf4;
}

.field-row {
  display: flex;
  gap: 16rpx;
}

.field-half {
  flex: 1;
  min-width: 0;
}

input,
textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx;
  color: #111;
  font-size: 26rpx;
  border: 1rpx solid #e1e8e4;
  border-radius: 8rpx;
  background: #f9fbfa;
}

input {
  min-height: 76rpx;
}

textarea {
  min-height: 160rpx;
  line-height: 1.5;
}

.form-actions {
  display: grid;
  grid-template-columns: 168rpx minmax(0, 1fr);
  gap: 16rpx;
  margin-top: 8rpx;
}

.primary-btn,
.small-btn,
.ghost-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
}

.primary-btn,
.small-btn {
  color: #fff;
  background: #18bf6a;
}

.primary-btn {
  min-height: 80rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.ghost-btn {
  min-height: 80rpx;
  color: #53605a;
  font-size: 27rpx;
  border: 1rpx solid #dfe7e2;
  background: #fff;
}

.small-btn {
  flex: 0 0 auto;
  min-width: 116rpx;
  min-height: 58rpx;
  padding: 0 16rpx;
  font-size: 24rpx;
}

.list-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 14rpx;
  padding: 20rpx;
}

.card-main {
  flex: 1;
  min-width: 0;
}

.card-title,
.card-desc,
.card-meta {
  display: block;
}

.card-title {
  color: #111;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-desc {
  margin-top: 8rpx;
  color: #5d6871;
  font-size: 24rpx;
  line-height: 1.45;
  word-break: break-all;
}

.card-meta,
.meta-row {
  margin-top: 10rpx;
  color: #158344;
  font-size: 23rpx;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.empty {
  min-height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  color: #808890;
  font-size: 26rpx;
}

.mini-empty {
  padding: 54rpx 0;
  color: #8a9399;
  font-size: 25rpx;
  text-align: center;
}

@media (max-width: 390px) {
  .page {
    padding-left: 20rpx;
    padding-right: 20rpx;
  }

  .hero,
  .section,
  .form-card,
  .list-card {
    padding-left: 18rpx;
    padding-right: 18rpx;
  }

  .title {
    font-size: 36rpx;
  }

  .refresh {
    padding: 0 12rpx;
    font-size: 22rpx;
  }

  .tabs {
    gap: 10rpx;
    padding: 0 20rpx;
  }

  .tab {
    min-width: 112rpx;
    font-size: 24rpx;
  }

  .dashboard-grid {
    gap: 12rpx;
  }

  .field-row {
    flex-direction: column;
    gap: 0;
  }

  .form-actions {
    grid-template-columns: 140rpx minmax(0, 1fr);
  }
}
